    "terminal.integrated.enableVisualBell": false,
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "editor.accessibilitySupport": "off",
    "cursor.general.glassShowWarningNotifications": true,
    "cursor.general.reduceTransparency": true,
    "window.autoDetectColorScheme": false,
    "cursor.composer.editorConversationDensity": "compact-ungrouped",
    "cursor.composer.conversationDensity": "compact-ungrouped",
    "python.languageServer": "None",
    "cursorpyright.disableLanguageServices": true,
    "js/ts.experimental.useTsgo": true,
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "git.openRepositoryInParentFolders": "never",
    "terminal.integrated.fontLigatures.enabled": true,
    "cursor.composer.queueMessageDefaultBehavior": "steer"
}
